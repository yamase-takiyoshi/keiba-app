<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="com.termux.permission.RUN_COMMAND"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <queries><package android:name="com.termux"/></queries>
    <application android:allowBackup="false" android:label="競馬収集 X96"
                 android:banner="@drawable/banner" android:icon="@drawable/appicon"
                 android:theme="@android:style/Theme.Material.NoActionBar">
      <activity android:name=".MainActivity" android:exported="true"
                android:screenOrientation="landscape">
        <intent-filter>
          <action android:name="android.intent.action.MAIN"/>
          <category android:name="android.intent.category.LAUNCHER"/>
        </intent-filter>
        <intent-filter>
          <action android:name="android.intent.action.MAIN"/>
          <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        </intent-filter>
      </activity>
      <receiver android:name=".ResultReceiver" android:exported="false"/>
    </application>
</manifest>
